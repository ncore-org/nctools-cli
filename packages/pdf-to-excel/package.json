{
  "name": "@nctools/pdf-to-excel",
  "version": "1.0.0",
  "description": "CLI: extract tables from a PDF into .xlsx (website: /tools/pdf-to-excel).",
  "type": "module",
  "bin": {
    "nctools-pdf-to-excel": "./bin/pdf-to-excel.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@nctools/core": "^1.0.0",
    "commander": "^12.1.0",
    "exceljs": "^4.4.0",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
